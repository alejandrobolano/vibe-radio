{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "viberadio",
  "main": "./worker/index.js",
  "compatibility_date": "2026-07-15",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "viberadio.net",
      "custom_domain": true
    },
    {
      "pattern": "www.viberadio.net",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "env": {
    "test": {
      "name": "viberadio-dev",
      "workers_dev": true,
      "preview_urls": true,
      "routes": [
        {
          "pattern": "dev.viberadio.net",
          "custom_domain": true
        }
      ]
    }
  }
}
